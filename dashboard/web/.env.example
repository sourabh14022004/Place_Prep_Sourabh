# ── PlacePrep web app ────────────────────────────────────────────────────
# Copy to .env.local and fill in. .env.local is gitignored.

# Where the Express API server is reachable. Next rewrites /api/* here, so the
# browser only ever sees this app's own origin — never set this to a URL the
# browser is expected to call directly, or cookies stop being same-origin.
API_URL=http://localhost:4000

# Public URL of this app. Used for metadataBase, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must be byte-identical to the API server's JWT_SECRET: proxy.ts verifies the
# same session cookies the API issues. If they diverge, every request 401s.
JWT_SECRET=
JWT_EXPIRES_IN=7d

NODE_ENV=development

# Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Restricted to @nst.rishihood.edu.in accounts
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
