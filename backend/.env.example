# ── PlacePrep API server ─────────────────────────────────────────────────
# Copy to .env.local and fill in. .env.local is gitignored and exists only on
# your machine — if you lose it, these values are unrecoverable. Keep the real
# ones in a password manager.

# MongoDB Atlas connection string.
# Special characters in the password must be percent-encoded (@ -> %40).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/placeprep?retryWrites=true&w=majority

# Signing key for session JWTs. Minimum 32 characters — jwt.ts rejects shorter.
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Port this API server listens on. The web app's API_URL must agree.
API_PORT=4000

# Public base URL of the web app. Used to build links that are sent to people
# (e.g. faculty invite URLs), so it must be the address a browser can reach.
SITE_URL=http://localhost:3000

# Email — optional in local dev; invite links can be shared manually instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PlacePrep NST <noreply@placeprep.nst>

# Google OAuth Client ID (Restricted to @nst.rishihood.edu.in accounts)
GOOGLE_CLIENT_ID=

NODE_ENV=development
