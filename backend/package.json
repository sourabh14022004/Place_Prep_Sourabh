{
  "name": "placeprep-backend",
  "version": "1.0.0",
  "description": "PlacePrep NST Interview Intelligence Portal \u2014 Node.js Backend Service Layer",
  "private": true,
  "main": "src/server.ts",
  "exports": {
    "./*": "./*"
  },
  "scripts": {
    "seed": "ts-node --project tsconfig.json src/scripts/seed.ts",
    "seed:reset": "ts-node --project tsconfig.json src/scripts/seed.ts --reset",
    "seed:real": "node scripts/seedRealData.js",
    "backfill:domains": "ts-node --project tsconfig.json src/scripts/backfill-doubt-domains.ts",
    "backfill:domains:write": "ts-node --project tsconfig.json src/scripts/backfill-doubt-domains.ts --write",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "backfill:mcq": "ts-node --project tsconfig.json src/scripts/backfill-mcq.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.1",
    "nodemailer": "^6.9.14",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "uuid": "^10.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0"
  }
}
